{
  "name": "maliyet",
  "compatibility_date": "2026-08-15",
  // Production lives on maliyet.lol only. Do not re-enable workers.dev:
  // this account's workers.dev subdomain is emlak-crm.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "maliyet.lol/*", "zone_name": "maliyet.lol" },
    { "pattern": "www.maliyet.lol/*", "zone_name": "maliyet.lol" }
  ],
  "assets": {
    "directory": "./dist",
    // Canonicals are no-slash (`/detailed`). Default auto-trailing-slash 307s
    // those URLs to `/detailed/`, which Google flags as canonical→redirect.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
